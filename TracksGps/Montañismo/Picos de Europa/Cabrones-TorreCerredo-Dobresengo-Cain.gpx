<?xml version="1.0" encoding="UTF-8"?><gpx creator="Wikiloc - http://www.wikiloc.com" version="1.1" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><wpt lat="43.213526" lon="-4.857093"><ele>2015.728</ele><name><![CDATA[Fuente]]></name><cmt><![CDATA[Fuente]]></cmt><desc><![CDATA[]]></desc><type>5</type></wpt><wpt lat="43.205721" lon="-4.851969"><ele>2236.341</ele><name><![CDATA[Collado de montaña]]></name><cmt><![CDATA[Collado de montaña]]></cmt><desc><![CDATA[]]></desc><type>94</type></wpt><wpt lat="43.204621" lon="-4.851458"><ele>2255.538</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.19816" lon="-4.85181"><ele>2549.89</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.197786" lon="-4.852885"><ele>2647.596</ele><name><![CDATA[Torre Cerredo, 2649 m]]></name><cmt><![CDATA[Torre Cerredo, 2649 m]]></cmt><desc><![CDATA[]]></desc><type>33</type></wpt><wpt lat="43.195063" lon="-4.850255"><ele>2488.228</ele><name><![CDATA[Collada Bermeja, 2476 m]]></name><cmt><![CDATA[Collada Bermeja, 2476 m]]></cmt><desc><![CDATA[]]></desc><type>94</type></wpt><wpt lat="43.194356" lon="-4.852601"><ele>2373.083</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.19401" lon="-4.853529"><ele>2327.408</ele><name><![CDATA[Intersección]]></name><cmt><![CDATA[Intersección]]></cmt><desc><![CDATA[]]></desc><type>74</type></wpt><wpt lat="43.195369" lon="-4.864679"><ele>1850.446</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.198355" lon="-4.867877"><ele>1897.813</ele><name><![CDATA[Collado de montaña]]></name><cmt><![CDATA[Collado de montaña]]></cmt><desc><![CDATA[]]></desc><type>94</type></wpt><wpt lat="43.198837" lon="-4.869934"><ele>1873.542</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.210374" lon="-4.879157"><ele>1051.807</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.211952" lon="-4.888378"><ele>812.525</ele><name><![CDATA[Fuente]]></name><cmt><![CDATA[Fuente]]></cmt><desc><![CDATA[]]></desc><type>5</type></wpt><wpt lat="43.215607" lon="-4.896981"><ele>714.886</ele><name><![CDATA[Intersección]]></name><cmt><![CDATA[Intersección]]></cmt><desc><![CDATA[]]></desc><type>74</type></wpt><wpt lat="43.214928" lon="-4.89883"><ele>561.278</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><wpt lat="43.211194" lon="-4.903582"><ele>461.727</ele><name><![CDATA[Río]]></name><cmt><![CDATA[Río]]></cmt><desc><![CDATA[]]></desc><type>72</type></wpt><wpt lat="43.213285" lon="-4.905236"><ele>462.514</ele><name><![CDATA[Foto]]></name><cmt><![CDATA[Foto]]></cmt><desc><![CDATA[]]></desc><type>36</type></wpt><trk><name><![CDATA[Refugio de Cabrones, Torre Cerredo, collada Bermeja, canal de Dobresengos, Caín]]></name><cmt><![CDATA[Muy difícil ruta que comienza en el refugio de Cabrones para, después de un rato por un terreno más fácil, llegar hasta la base de Torre Cerredo. Allí dejamos las mochilas y empezamos la subida siguiendo los numerosos hitos que hay en la misma. La subida tiene múltiples trepadas y hay que saber escoger el mejor camino, aunque en ningún momento hay excesivos pasos aéreos que compliquen la ascensión. Una vez arriba, y con un día despejado como el que hemos tenido, las vistas son espectaculares de todos los Picos de Europa e incluso del mar Cantábrico.
La bajada, por el mismo sitio que la subida, y después de recuperar las mochilas, nos enfrentamos al reto de la bajada desde la collada Bermeja que, a mi parecer, es más complicada que la subida a Torre Cerredo, teniendo un paso aéreo bastante expuesto.
Una vez llegado al jou, y avanzando por él, nos acercamos a la canal de Dobresengos, que también tiene algo de dificultad, pero bastante menos que la bajada anterior.
Por último, cogemos el Sedo que nos lleva hasta Caín. El primer tramo del Sedo es bastante complicado porque está muy húmedo y la piedra resbala muchísimo así que hay que prestar mucha atención a dónde se pone el pie.]]></cmt><desc><![CDATA[Muy difícil ruta que comienza en el refugio de Cabrones para, después de un rato por un terreno más fácil, llegar hasta la base de Torre Cerredo. Allí dejamos las mochilas y empezamos la subida siguiendo los numerosos hitos que hay en la misma. La subida tiene múltiples trepadas y hay que saber escoger el mejor camino, aunque en ningún momento hay excesivos pasos aéreos que compliquen la ascensión. Una vez arriba, y con un día despejado como el que hemos tenido, las vistas son espectaculares de todos los Picos de Europa e incluso del mar Cantábrico.
La bajada, por el mismo sitio que la subida, y después de recuperar las mochilas, nos enfrentamos al reto de la bajada desde la collada Bermeja que, a mi parecer, es más complicada que la subida a Torre Cerredo, teniendo un paso aéreo bastante expuesto.
Una vez llegado al jou, y avanzando por él, nos acercamos a la canal de Dobresengos, que también tiene algo de dificultad, pero bastante menos que la bajada anterior.
Por último, cogemos el Sedo que nos lleva hasta Caín. El primer tramo del Sedo es bastante complicado porque está muy húmedo y la piedra resbala muchísimo así que hay que prestar mucha atención a dónde se pone el pie.]]></desc><trkseg><trkpt lat="43.214099" lon="-4.857686"><ele>2055.833</ele><time>2024-09-15T06:06:42Z</time></trkpt><trkpt lat="43.214058" lon="-4.857725"><ele>2055.223</ele><time>2024-09-15T06:06:45Z</time></trkpt><trkpt lat="43.214035" lon="-4.857612"><ele>2045.515</ele><time>2024-09-15T06:07:07Z</time></trkpt><trkpt lat="43.214079" lon="-4.857569"><ele>2044.909</ele><time>2024-09-15T06:07:31Z</time></trkpt><trkpt lat="43.21405" lon="-4.857617"><ele>2040.064</ele><time>2024-09-15T06:07:57Z</time></trkpt><trkpt lat="43.214008" lon="-4.857577"><ele>2026.951</ele><time>2024-09-15T06:08:38Z</time></trkpt><trkpt lat="43.213998" lon="-4.857515"><ele>2026.838</ele><time>2024-09-15T06:08:45Z</time></trkpt><trkpt lat="43.21396" lon="-4.857481"><ele>2026.623</ele><time>2024-09-15T06:08:53Z</time></trkpt><trkpt lat="43.213912" lon="-4.857477"><ele>2028.664</ele><time>2024-09-15T06:09:05Z</time></trkpt><trkpt lat="43.213873" lon="-4.85744"><ele>2029.846</ele><time>2024-09-15T06:09:14Z</time></trkpt><trkpt lat="43.213832" lon="-4.857411"><ele>2029.477</ele><time>2024-09-15T06:09:22Z</time></trkpt><trkpt lat="43.213797" lon="-4.857372"><ele>2028.446</ele><time>2024-09-15T06:09:30Z</time></trkpt><trkpt lat="43.213786" lon="-4.85731"><ele>2027.648</ele><time>2024-09-15T06:09:39Z</time></trkpt><trkpt lat="43.213746" lon="-4.857277"><ele>2026.673</ele><time>2024-09-15T06:09:47Z</time></trkpt><trkpt lat="43.213698" lon="-4.857255"><ele>2024.685</ele><time>2024-09-15T06:09:53Z</time></trkpt><trkpt lat="43.213658" lon="-4.857211"><ele>2024.013</ele><time>2024-09-15T06:10:00Z</time></trkpt><trkpt lat="43.213611" lon="-4.857186"><ele>2021.609</ele><time>2024-09-15T06:10:12Z</time></trkpt><trkpt lat="43.213581" lon="-4.857138"><ele>2019.058</ele><time>2024-09-15T06:10:20Z</