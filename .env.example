# Copia este fichero a .env y ajusta los valores. .env no va a git.

# Motor de base de datos de la aplicación: sqlite (por defecto) | postgres
DB_DRIVER=sqlite

# PostgreSQL (docker-compose.yml)
PG_DB=gpxlibrary
PG_USER=gpx
PG_PASSWORD=cambia-esta-contraseña
PG_PORT=5432
DATABASE_URL=postgres://gpx:cambia-esta-contraseña@127.0.0.1:5432/gpxlibrary

# Almacén de los GPX originales: local (TracksGps/store, por defecto) | s3
# `node scripts/storage-setup.js` genera estos valores para Garage (docker-compose) y crea los buckets.
STORAGE_DRIVER=local
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=gpxlibrary
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
