# Copia este fichero a .env y ajusta los valores. .env no va a git.

# Motor de base de datos de la aplicación: sqlite (por defecto) | postgres
DB_DRIVER=sqlite

# PostgreSQL (docker-compose.yml)
PG_DB=gpxlibrary
PG_USER=gpx
PG_PASSWORD=cambia-esta-contraseña
PG_PORT=5432
DATABASE_URL=postgres://gpx:cambia-esta-contraseña@127.0.0.1:5432/gpxlibrary
